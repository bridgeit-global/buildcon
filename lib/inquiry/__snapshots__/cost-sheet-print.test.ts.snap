// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildCostSheetHtml > matches snapshot for fixed fixture 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Cost sheet — A-101</title>
  <style>
    
    @page { size: A4; margin: 18mm 16mm; }
    * { box-sizing: border-box; }
    body {
      font-family: "BuildCon Print", "Times New Roman", Times, serif;
      font-size: 12pt;
      line-height: 1.45;
      color: #000;
      margin: 0;
      padding: 0;
    }
    .doc { max-width: 180mm; margin: 0 auto; }
    .brand {
      text-align: center;
      font-size: 14pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      margin: 0 0 4px;
    }
    .doc-title {
      text-align: center;
      font-size: 13pt;
      font-weight: 700;
      text-decoration: underline;
      margin: 0 0 18px;
    }
    .meta {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
      font-size: 11pt;
    }
    .para { margin: 0 0 10px; text-align: justify; }
    .details {
      width: 100%;
      border-collapse: collapse;
      margin: 14px 0 18px;
      font-size: 11pt;
    }
    .details th,
    .details td {
      border: 1px solid #000;
      padding: 6px 10px;
      vertical-align: top;
      text-align: left;
    }
    .details th {
      width: 36%;
      font-weight: 600;
      background: #f5f5f5;
    }
    .sign-block { margin-top: 28px; }
    .sign-line {
      margin-top: 44px;
      border-top: 1px solid #000;
      width: 220px;
      padding-top: 6px;
      font-size: 11pt;
    }
    .muted { font-size: 10pt; color: #333; margin-top: 20px; }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  
    .total-banner {
      margin: 16px 0 20px;
      padding: 12px 14px;
      border: 1px solid #0d9488;
      background: #f0fdfa;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .total-banner strong { font-size: 13pt; color: #0f766e; }
    .section-title {
      margin: 18px 0 8px;
      font-size: 10pt;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #64748b;
    }
  </style>
</head>
<body>
  <div class="doc">
    <p class="brand">BuildCon</p>
    <p class="doc-title">Cost sheet</p>
    <div class="meta">
      <span><strong>Unit:</strong> A-101</span>
      <span><strong>Date:</strong> 15-06-2026</span>
    </div>
    <p class="para">Prepared for <strong>Ravi Kumar</strong></p>
    <p class="para"><strong>Sunrise Heights</strong> · Tower A</p>
    <div class="total-banner">
      <span>Estimated total</span>
      <strong>₹ 63.63 Lac</strong>
    </div>
    <h2 class="section-title">Unit details</h2>
<table class="details"><tbody><tr><th>Project</th><td>Sunrise Heights</td></tr><tr><th>Unit code</th><td>A-101</td></tr><tr><th>Wing / tower</th><td>Tower A</td></tr><tr><th>Floor</th><td>Floor 12</td></tr><tr><th>Unit slot on floor</th><td>101</td></tr><tr><th>Configuration</th><td>3 BHK</td></tr><tr><th>Status</th><td>Available</td></tr><tr><th>Carpet area</th><td>900 sq.ft</td></tr><tr><th>BUA area</th><td>1,050 sq.ft</td></tr><tr><th>Saleable area</th><td>1,200 sq.ft</td></tr><tr><th>Billable (pricing)</th><td>900 sq.ft (legacy saleable 1,200)</td></tr><tr><th>Parking bundled with unit</th><td>1 slot</td></tr></tbody></table>
    <h2 class="section-title">Pricing &amp; charges</h2>
<table class="details"><tbody><tr><th>Basic rate</th><td>₹ 5,500 / sq.ft</td></tr><tr><th>Base (billable × rate)</th><td>₹ 49,50,000 (900 × ₹ 5,500)</td></tr><tr><th>Floor-rise (lump)</th><td>₹ 75,000</td></tr><tr><th>PLC (lump)</th><td>₹ 50,000</td></tr><tr><th>Agreement value (dwelling)</th><td>₹ 50.75 Lac (₹ 50,75,000)</td></tr><tr><th>Parking availability (project)</th><td>2 slots available · ₹3,50,000 / slot</td></tr><tr><th>Parking (customer ask)</th><td>Yes · 2 slots</td></tr><tr><th>Parking extra (est.)</th><td>₹ 7,00,000 (2 × ₹ 3,50,000)</td></tr><tr><th>GST (est. 5%)</th><td>₹ 2,53,750 (₹ 2,53,750)</td></tr><tr><th>Stamp duty (est. 6% of dwelling)</th><td>₹ 3,04,500</td></tr><tr><th>Registration (est.)</th><td>₹ 30,000</td></tr><tr><th>Estimated total</th><td>₹ 63.63 Lac (₹ 63,63,250)</td></tr></tbody></table>
    <p class="muted">
      Estimate only. Stamp duty, registration, and other statutory charges follow project
      settings where configured. Confirm final numbers on the formal quotation or agreement.
    </p>
  </div>
</body>
</html>"
`;
